<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.velora" path="/org/gnome/shell/extensions/velora/">
    <key name="bootstrap-loaded-generation" type="s">
      <default>''</default>
      <summary>Internal bootstrap generation loaded by GNOME Shell</summary>
    </key>
    <key name="bootstrap-loaded-revision" type="s">
      <default>''</default>
      <summary>Internal bootstrap fingerprint loaded by GNOME Shell</summary>
    </key>
    <key name="runtime-revision" type="s">
      <default>'base'</default>
      <summary>Requested hot-swap runtime revision</summary>
    </key>
    <key name="runtime-loaded-revision" type="s">
      <default>''</default>
      <summary>Runtime revision currently loaded by the bootstrap</summary>
    </key>
    <key name="runtime-error" type="s">
      <default>''</default>
      <summary>Runtime hot-swap error status</summary>
    </key>

    <key name="orb-enabled" type="b">
      <default>true</default>
      <summary>Show the Velora Orb</summary>
    </key>
    <key name="orb-size" type="i">
      <default>44</default>
      <range min="20" max="80"/>
      <summary>Velora Orb size</summary>
    </key>
    <key name="orb-opacity" type="i">
      <default>100</default>
      <range min="0" max="100"/>
      <summary>Velora Orb opacity percentage</summary>
    </key>
    <key name="orb-icon" type="s">
      <default>'start-here-symbolic'</default>
      <summary>Themed icon name or absolute SVG/PNG path used by the Orb</summary>
    </key>
    <key name="orb-x" type="d">
      <default>0.015</default>
      <range min="0.0" max="1.0"/>
      <summary>Normalized horizontal Orb position</summary>
    </key>
    <key name="orb-y" type="d">
      <default>0.065</default>
      <range min="0.0" max="1.0"/>
      <summary>Normalized vertical Orb position</summary>
    </key>
    <key name="auto-hide-orb" type="b">
      <default>false</default>
      <summary>Slide the Orb to the nearest monitor edge while idle</summary>
    </key>
    <key name="auto-hide-delay" type="i">
      <default>1400</default>
      <range min="0" max="10000"/>
      <summary>Milliseconds before the idle Orb auto-hides</summary>
    </key>
    <key name="auto-fade-orb" type="b">
      <default>true</default>
      <summary>Fade the Orb while idle when auto-hide is disabled</summary>
    </key>
    <key name="auto-fade-delay" type="i">
      <default>5000</default>
      <range min="0" max="30000"/>
      <summary>Milliseconds before the idle Orb fades</summary>
    </key>

    <key name="glass-opacity" type="i">
      <default>12</default>
      <range min="0" max="100"/>
      <summary>System Liquid Glass tint strength percentage</summary>
    </key>
    <key name="glass-tint-color" type="s">
      <default>'#ffffff'</default>
      <summary>System Liquid Glass tint color</summary>
    </key>
    <key name="glass-blur" type="i">
      <default>20</default>
      <range min="0" max="80"/>
      <summary>System Liquid Glass blur radius</summary>
    </key>
  </schema>
</schemalist>
